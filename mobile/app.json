{
  "expo": {
    "name": "QueueLess",
    "slug": "queueless",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "queueless",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.queueless.app"
    },
    "android": {
      "package": "com.queueless.app",
      "permissions": ["NOTIFICATIONS"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#4F46E5"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
